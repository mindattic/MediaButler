@using MediaButler.Settings
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="app-shell">
    <header class="app-header">
        <div class="header-row">
            <h1>MediaButler</h1>
            <div class="settings-cog-group">
                <span role="status" aria-live="polite" class="status-label">@cogStatus</span>
                @* LAMP (MB-T27): MediaButler has no settings screen of its own. The cog
                   opens MindAttic.Vault.Desktop at the MediaButler tab, the only place its
                   settings and keys are edited. *@
                <button type="button" id="settings-cog" class="settings-cog"
                        title="Settings (opens MindAttic Vault)"
                        aria-label="Settings (opens MindAttic Vault)"
                        @onclick="OnSettingsCog">&#x2699;</button>
            </div>
        </div>
    </header>

    <main id="main-content">
        <Run @ref="runRef" />
    </main>
</div>

@code {
    private Run? runRef;
    private string cogStatus = "";
    private DotNetObjectReference<TabShell>? selfRef;

    private void OnSettingsCog() => cogStatus = SettingsCog.Open().Message ?? "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        selfRef = DotNetObjectReference.Create(this);
        // Settings edited in Vault while MediaButler was in the background show up
        // in the Run header as soon as the window has focus again.
        try { await JS.InvokeVoidAsync("mediaButlerInterop.onWindowFocus", selfRef); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { /* prerendering / no JS */ }
    }

    [JSInvokable]
    public void OnWindowFocus()
    {
        cogStatus = "";
        runRef?.OnTabActivated();
    }

    public ValueTask DisposeAsync()
    {
        selfRef?.Dispose();
        return ValueTask.CompletedTask;
    }
}
