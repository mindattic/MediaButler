<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      WebView2's WPF composition control (Microsoft.Web.WebView2.Wpf) needs
      WinRT/Windows SDK contracts that only resolve on a Windows-SDK-versioned
      TFM. Plain net10.0-windows throws FileNotFoundException for
      Microsoft.Windows.SDK.NET at first paint (TryInitializeD3DImage) — the
      old MAUI shell targeted the same versioned TFM for the same reason.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>MediaButler.Wpf</RootNamespace>
    <AssemblyName>MediaButler.Wpf</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.51" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaButler\MediaButler.csproj" />
    <ProjectReference Include="..\MediaButler.Wpf.UI\MediaButler.Wpf.UI.csproj" />
  </ItemGroup>


</Project>
